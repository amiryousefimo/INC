package ir.tamin.incomeBank.dao.financialDoc;


import ir.tamin.incomeBank.dao.BaseDAOService;
import ir.tamin.incomeBank.model.commonList.CommonLIst;
import ir.tamin.incomeBank.model.financialDoc.ConflictDoc;

import javax.inject.Inject;
import javax.persistence.EntityManager;

public class ConflictDocDAOService extends BaseDAOService<ConflictDoc> {

    @Inject
    private EntityManager em;


    @Override
    public Class<ConflictDoc> getClazz() {
        return ConflictDoc.class;
    }

    @Override
    public EntityManager getEntityManager() {
        return em;
    }
}
