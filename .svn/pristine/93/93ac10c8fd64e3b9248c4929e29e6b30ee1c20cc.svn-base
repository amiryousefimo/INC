package ir.tamin.incomeBank.model.payment3070.daily;

import lombok.Getter;
import lombok.Setter;

import javax.persistence.*;
import java.math.BigDecimal;


@Entity
@Table(name = "vwsorat_3070_det")
@Getter
@Setter
public class Daily3070 {

    @Id
    @Column(name = "rownum")
    private String rowNum;

    @Column(name = "sorat_row")
    private BigDecimal soratRow;

    @Column(name = "sorat_date")
    private String soratDate;

    @Column(name = "sorat_ordpay")
    private String soratOrdPay;

    @Column(name = "sorat_bank")
    private String soratBank;

    @Column(name = "sorat_price1")
    private BigDecimal soratPrice1;

    @Column(name = "sorat_price2")
    private BigDecimal soratPrice2;

    @Column(name = "sorat_efdate")
    private String soratEfDate;

    @Column(name = "sorat_payment_seq")
    private String soratPaySeq;

}
