package ir.tamin.incomeBank.model.announcement.branch;


import javax.persistence.*;
import java.io.Serializable;
import java.math.BigDecimal;

/**
 * @author A_Jamali
 */
@Entity
@Table(name = "vwletter_brch")
public class AnnouncementBranch implements Serializable {
    private static final long serialVersionUID = 1L;
    @Id
    @Column(name = "rownum")
    private String rowNum;

    @Column(name = "BRCH_CODE")
    private String brchCode;

    @Column(name = "BRCH_NAME")
    private String brchName;

    @Column(name = "EDKOL_CODE")
    private String edareCode;

    @Column(name = "EDKOL_NAME")
    private String edareName;
    @Column(name = "LETTER_DATE")
    private String letterDate;

    @Column(name = "KARKONAN")
    private BigDecimal employees;

    @Column(name = "KARKONAN_CNT")
    private BigDecimal employeesCount;

    @Column(name = "PEYMAN")
    private BigDecimal peyman;

    @Column(name = "PEYMAN_CNT")
    private BigDecimal peymanCount;

    @Column(name = "SUM_AMT")
    private BigDecimal sumAmount;

    @Column(name = "SUM_CNT")
    private BigDecimal sumCount;

    public String getRowNum() {
        return rowNum;
    }

    public void setRowNum(String rowNum) {
        this.rowNum = rowNum;
    }

    public String getBrchCode() {
        return brchCode;
    }

    public void setBrchCode(String brchCode) {
        this.brchCode = brchCode;
    }

    public String getBrchName() {
        return brchName;
    }

    public void setBrchName(String brchName) {
        this.brchName = brchName;
    }

    public String getEdareCode() {
        return edareCode;
    }

    public void setEdareCode(String edareCode) {
        this.edareCode = edareCode;
    }

    public String getEdareName() {
        return edareName;
    }

    public void setEdareName(String edareName) {
        this.edareName = edareName;
    }

    public String getLetterDate() {
        return letterDate;
    }

    public void setLetterDate(String letterDate) {
        this.letterDate = letterDate;
    }

    public BigDecimal getEmployees() {
        return employees;
    }

    public void setEmployees(BigDecimal employees) {
        this.employees = employees;
    }

    public BigDecimal getEmployeesCount() {
        return employeesCount;
    }

    public void setEmployeesCount(BigDecimal employeesCount) {
        this.employeesCount = employeesCount;
    }

    public BigDecimal getPeyman() {
        return peyman;
    }

    public void setPeyman(BigDecimal peyman) {
        this.peyman = peyman;
    }

    public BigDecimal getPeymanCount() {
        return peymanCount;
    }

    public void setPeymanCount(BigDecimal peymanCount) {
        this.peymanCount = peymanCount;
    }

    public BigDecimal getSumAmount() {
        return sumAmount;
    }

    public void setSumAmount(BigDecimal sumAmount) {
        this.sumAmount = sumAmount;
    }

    public BigDecimal getSumCount() {
        return sumCount;
    }

    public void setSumCount(BigDecimal sumCount) {
        this.sumCount = sumCount;
    }
}
