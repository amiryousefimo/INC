package ir.tamin.incomeBank.model.officeCollectionSystemCenter;

/**
 * @author f_mousavi
 */

public class OfficeCollectionSystemCenterModel {
    private String edKolName;
    private String brchName;
    private Object ordDate1;
    private Object ordDate2;
    private String amountBed;
    private String amountBes;
    private String ordOrdNo;
    private String bankName;
    private Long sumAmountBed;
    private Long sumAmountBes;

    public String getEdKolName() {
        return edKolName;
    }

    public void setEdKolName(String edKolName) {
        this.edKolName = edKolName;
    }

    public String getBrchName() {
        return brchName;
    }

    public void setBrchName(String brchName) {
        this.brchName = brchName;
    }

    public Object getOrdDate1() {
        return ordDate1;
    }

    public void setOrdDate1(Object ordDate1) {
        this.ordDate1 = ordDate1;
    }

    public Object getOrdDate2() {
        return ordDate2;
    }

    public void setOrdDate2(Object ordDate2) {
        this.ordDate2 = ordDate2;
    }

    public String getAmountBed() {
        return amountBed;
    }

    public void setAmountBed(String amountBed) {
        this.amountBed = amountBed;
    }

    public String getAmountBes() {
        return amountBes;
    }

    public void setAmountBes(String amountBes) {
        this.amountBes = amountBes;
    }

    public String getOrdOrdNo() {
        return ordOrdNo;
    }

    public void setOrdOrdNo(String ordOrdNo) {
        this.ordOrdNo = ordOrdNo;
    }

    public String getBankName() {
        return bankName;
    }

    public void setBankName(String bankName) {
        this.bankName = bankName;
    }

    public Long getSumAmountBed() {
        return sumAmountBed;
    }

    public void setSumAmountBed(Long sumAmountBed) {
        this.sumAmountBed = sumAmountBed;
    }

    public Long getSumAmountBes() {
        return sumAmountBes;
    }

    public void setSumAmountBes(Long sumAmountBes) {
        this.sumAmountBes = sumAmountBes;
    }
}
