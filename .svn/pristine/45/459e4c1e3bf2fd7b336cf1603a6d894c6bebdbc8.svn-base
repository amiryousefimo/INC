package ir.tamin.incomeBank.dao.financialDoc;

import ir.tamin.incomeBank.dao.BaseDAOService;
import ir.tamin.incomeBank.model.financialDoc.DisagreementView;

import javax.inject.Inject;
import javax.persistence.EntityManager;

public class DisagreementViewDAOService extends BaseDAOService<DisagreementView> {
    @Inject
    private EntityManager entityManager;

    @Override
    public Class<DisagreementView> getClazz() {
        return DisagreementView.class;
    }

    @Override
    public EntityManager getEntityManager() {
        return entityManager;
    }
}
