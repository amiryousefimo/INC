package ir.tamin.incomeBank.model.financialDoc.newFinancialDoc3070;

import lombok.AllArgsConstructor;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.Setter;

import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.Id;
import javax.persistence.Table;
import java.io.Serializable;

@Entity

@Table(name = "DRMD_STATUS_ACC_3070")
@Setter
@Getter
@AllArgsConstructor
@NoArgsConstructor
public class FinancialDocStatus implements Serializable {

    private static final long serialVersionUID = 1L;

    @Id
    @Column(name = "ROWNUM")
    private String rowId;

    @Column(name = "DRMD_YY")
    private String daramadYear;

    @Column(name = "DRMD_MM")
    private String daramadMonth;

    @Column(name = "STATUS")
    private Long status;

    @Column(name = "DESCRIPTION")
    private String description;

}
