package ir.tamin.incomeBank.model.workshopDebitReport.country;

import java.math.BigDecimal;


/**
 * @author  A_Jamali
 */

public class WorkshopDebitReportSummeryCountry {
    private BigDecimal sumAmountBed;
    private BigDecimal sumAmountBes;
    private BigDecimal sumRemainAmount;

    public WorkshopDebitReportSummeryCountry() {
    }

    public WorkshopDebitReportSummeryCountry(BigDecimal sumAmountBed, BigDecimal sumAmountBes, BigDecimal sumRemainAmount) {
        this.sumAmountBed = sumAmountBed;
        this.sumAmountBes = sumAmountBes;
        this.sumRemainAmount = sumRemainAmount;
    }

    public BigDecimal getSumAmountBed() {
        return sumAmountBed;
    }

    public void setSumAmountBed(BigDecimal sumAmountBed) {
        this.sumAmountBed = sumAmountBed;
    }

    public BigDecimal getSumAmountBes() {
        return sumAmountBes;
    }

    public void setSumAmountBes(BigDecimal sumAmountBes) {
        this.sumAmountBes = sumAmountBes;
    }

    public BigDecimal getSumRemainAmount() {
        return sumRemainAmount;
    }

    public void setSumRemainAmount(BigDecimal sumRemainAmount) {
        this.sumRemainAmount = sumRemainAmount;
    }
}
