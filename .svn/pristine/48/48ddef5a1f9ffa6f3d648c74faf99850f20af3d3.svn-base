package ir.tamin.incomeBank.model.workshopDebitReport.workshop;

import java.math.BigDecimal;

public class WorkshopDebitReportSummery {
    private BigDecimal orderAmount;
    private BigDecimal bankAmount;

    public WorkshopDebitReportSummery() {
    }

    public WorkshopDebitReportSummery(BigDecimal orderAmount, BigDecimal bankAmount) {
        this.orderAmount = orderAmount;
        this.bankAmount = bankAmount;
    }

    public BigDecimal getOrderAmount() {
        return orderAmount;
    }

    public void setOrderAmount(BigDecimal orderAmount) {
        this.orderAmount = orderAmount;
    }

    public BigDecimal getBankAmount() {
        return bankAmount;
    }

    public void setBankAmount(BigDecimal bankAmount) {
        this.bankAmount = bankAmount;
    }
}
