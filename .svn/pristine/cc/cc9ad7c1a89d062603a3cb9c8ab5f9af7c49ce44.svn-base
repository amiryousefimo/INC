package ir.tamin.incomeBank.model.financialDoc.newFinancialDocSpec;

import lombok.AllArgsConstructor;
import lombok.Getter;
import lombok.NoArgsConstructor;
import lombok.Setter;

import javax.persistence.Column;
import javax.persistence.Entity;
import javax.persistence.Id;
import javax.persistence.Table;
import java.math.BigDecimal;

@Entity
@Table(name = "VWMOGHLIS_LIST_2")
@Getter
@Setter
@AllArgsConstructor
@NoArgsConstructor
public class SpecialInsuredsReportDocSpec {

    @Id
    @Column(name = "ROWNUM")
    private String rowId;

    @Column(name = "SORAT_ORDPAY")
    private String soratOrderPay;

    @Column(name = "SORAT_DATE")
    private String soratDate;//تاریخ وصول

    @Column(name = "SORAT_PRICE1")
    private BigDecimal soratPrice1;//مبلغ وصول

    @Column(name = "SORAT_EFDATE")
    private String soratEfDate;//تاریخ موثر

    @Column(name = "SYSTEM_TYPE")
    private String systemType;

    @Column(name = "SYSTEM_DESC")
    private String systemDesc;

    @Column(name = "SORAT_ROW")
    private String soratRow;

}
